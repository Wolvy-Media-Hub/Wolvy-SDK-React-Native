{
  "name": "@wolvy/react-native",
  "version": "0.2.0",
  "description": "Plays Wolvy's DRM-protected video in React Native apps: Widevine on Android, FairPlay on iOS, the viewer watermark, screen-capture protection and the web Player API's methods and events.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "wolvy-react-native-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "lib",
    "android",
    "ios",
    "react-native.config.js",
    "*.podspec",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!ios/build"
  ],
  "scripts": {
    "example": "yarn workspace @wolvy/react-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "node --test \"src/__tests__/*.test.ts\""
  },
  "keywords": [
    "react-native",
    "android",
    "video",
    "drm",
    "widevine",
    "wolvy",
    "player"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolvy-Media-Hub/Wolvy-SDK-React-Native.git"
  },
  "author": "Wolvy <contact@wolvy.net> (https://wolvy.net)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Wolvy-Media-Hub/Wolvy-SDK-React-Native/issues"
  },
  "homepage": "https://docs.wolvy.net/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.44.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "WolvyPlayerSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "net.wolvy.player.reactnative"
    },
    "ios": {
      "componentProvider": {
        "WolvyPlayerView": "WolvyPlayerComponentView"
      },
      "modulesProvider": {
        "WolvyPlayerModule": "WolvyPlayerModule"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  }
}
